# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never prefix them with NEXT_PUBLIC_.

# Supabase → Project Settings → API
SUPABASE_URL=
# Settings → API Keys → Secret keys (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin: at least 12 characters (long and random is best)
ADMIN_PASSWORD=

# 32+ random characters, e.g. `openssl rand -hex 32`. Signs the admin login and hashes visitor IPs.
COMMENTS_SECRET=
